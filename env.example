# BetterTaalBatangas.org settings
# Copy this file to .env.local and fill in the values. .env.local is not committed.

# Site address and search/share details
VITE_WEBSITE_URL="https://bettertaalbatangas.org"
VITE_SITE_DESCRIPTION="A volunteer-run guide to the services, offices and officials of the Municipality of Taal, Batangas."
VITE_SITE_KEYWORDS="Taal, Batangas, municipality, services, Citizen's Charter, hotlines"
VITE_OG_IMAGE_URL="https://bettertaalbatangas.org/og-image.jpg"
VITE_TWITTER_HANDLE=""

# Volunteer contact email. When set, an Email section appears on the Contact page.
VITE_CONTACT_EMAIL=""

# Google Form for "Report an issue". Until set, the Contact page says the form is coming soon.
VITE_REPORT_ISSUE_URL=""

# Cost to build the site to date, shown in the footer strip (e.g. "3,000").
# Leave empty to show "Built and paid for by volunteers."
VITE_BUILD_COST=""

# Optional: Meilisearch for the /search page. The built-in header search works without it.
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""
